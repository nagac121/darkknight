{
  "name": "Dark Knight",
  "type": "dark",
  "tokenColors": [
    {
      "name": "String, Symbols, Inherited Class, Markup Heading",
      "scope": [
        "string",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#F8D061"
      }
    },
    {
      "name": "JSX Text Nodes",
      "scope": ["text.html.jsx", "meta.jsx.children"],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "JSX Attribute Names (className, etc.)",
      "scope": [
        "entity.other.attribute-name.js",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "JSX/HTML Tag Names",
      "scope": [
        "entity.name.tag.jsx",
        "entity.name.tag.js",
        "entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#8decb9"
      }
    },
    {
      "name": "JS/JSX White Identifiers",
      "scope": [
        "variable.parameter",
        "variable.other.constant",
        "entity.name.function",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "JS/JSX Brown Identifiers",
      "scope": ["string.template", "string.quoted.double"],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "JS/JSX Variables",
      "scope": ["variable.other.property"],
      "settings": {
        "foreground": "#ea9999"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#93c47d"
      }
    }
  ]
}
