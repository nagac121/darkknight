{
  "name": "Dark Knight",
  "type": "dark",
  "colors": {
    "editor.background": "#000000", // Black background
    "editor.foreground": "#ffffff", // Default text color (fallback)
    "editorCursor.foreground": "#ffffff", // White cursor
    "editor.lineHighlightBorder": "#00000000", // No border for line highlight
    "editor.lineHighlightBackground": "#ffff002b", // Line highlight with transparency
    "editor.inactiveSelectionBackground": "#33333380", // Inactive selection with transparency
    "editorWhitespace.foreground": "#444444", // Whitespace dots
    "editorIndentGuide.background1": "#333333", // Indent guides
    "editorIndentGuide.activeBackground1": "#666666"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6a9955", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": { "foreground": "#ce9178" }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": { "foreground": "#569cd6" }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": { "foreground": "#b5cea8" }
    },
    {
      "name": "Function Name",
      "scope": "entity.name.function",
      "settings": { "foreground": "#dcdcaa" }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": { "foreground": "#9cdcfe" }
    }
  ]
}
